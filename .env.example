# Copy this file to `.env` and fill in what you need.
# Nothing here is required to run the model: `python -m heatcanyon.cli build`
# and `serve` work with an empty file. Each key unlocks one optional thing.

# ---------------------------------------------------------------- FortyGuard
# Only needed to re-fetch the temperature data. The responses this project used
# are committed under data/manhattan/, so the whole build reproduces offline for
# zero credits and a running demo can never spend any.
FORTYGUARD_API_KEY=your_api_key_here

# Optional — override the default production base URL.
# Development: https://tos-enterprise-api.dev.app.fortyguard.com
# Production:  https://api.fortyguard.com
FORTYGUARD_BASE_URL=https://api.fortyguard.com

# ------------------------------------------------------------- the year axis
# Nothing to set. The 8,760-hour ERA5 series comes from Open-Meteo's archive,
# which needs no key at all:  python scripts/fetch_year.py
# See docs/YEAR.md.

# ------------------------------------------------------------- the photoreal
# Enables Google's 3D Tiles layer in the web app. Off by default, and with the
# toggle untouched no root tile request is ever issued, so the session is free.
# Restrict the key to the Map Tiles API, add an HTTP-referrer restriction, and
# cap the root-tile-request quota.
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# ------------------------------------------------------------------ the voice
# The opening film's narration. Without a key the film is read by the browser's
# own speech synthesiser, exactly as it was before this existed — so this is an
# upgrade, never a requirement.
#
# What it costs: nothing, in the normal case. Every line is synthesised once and
# cached to web/data/vo/, which is COMMITTED, so a fresh clone plays the real
# read offline having spent nothing. And a page load cannot spend even with a key
# present: the endpoint the film calls is a cache read, and only
# `node scripts/prewarm_voice.mjs` sets the flag that allows synthesis. That
# asymmetry is not decoration — the cache here was first filled by a Playwright
# suite in another terminal, which played the film and spent a third of the
# month's free allowance before anyone noticed.
#
# Re-bake after editing story.js or re-running the pipeline, since the script's
# figures come from the model and a changed sentence is a new recording:
#   node scripts/prewarm_voice.mjs --dry     # what changed, and what it costs
#   node scripts/prewarm_voice.mjs           # buy it, once
#   heatcanyon voice                         # cache, plan, and settings
#   heatcanyon voice --voices                # the voice ids on the account
ELEVENLABS_API_KEY=

# Daniel — British, low, unhurried; ElevenLabs' "Steady Broadcaster". The film is
# written in that register. `heatcanyon voice --voices` prints the alternatives;
# George (JBFqnCBsd6RMkjVDRZzb) is the warmer storyteller of the two British men.
# HEATCANYON_VOICE_ID=onwK4e9ZLuTAKqWW03F9

# eleven_multilingual_v2 costs one credit per character and sounds like someone
# reading; eleven_turbo_v2_5 costs half that and sounds like someone announcing.
# HEATCANYON_VOICE_MODEL=eleven_multilingual_v2
# HEATCANYON_VOICE_FORMAT=mp3_44100_128

# High stability and no style exaggeration: the script's job is to be believed,
# and the score is already doing the emotional work.
# HEATCANYON_VOICE_STABILITY=0.55
# HEATCANYON_VOICE_SIMILARITY=0.80
# HEATCANYON_VOICE_STYLE=0.0

# What one server process may spend, whatever asks it to. The plan's own quota is
# the backstop; this is the guard that stops a loop from finding it. The whole
# script is about 2,600 characters, so this is two bakes.
# HEATCANYON_VOICE_BUDGET_CHARS=6000

# Off entirely — the film falls back to the browser's voice.
# HEATCANYON_VOICE=0


# ---------------------------------------------------------------- the analyst
# The analyst is Claude Code as a library (docs/AGENT.md). It needs ONE
# credential family, and which one is chosen by HEATCANYON_AGENT_AUTH:
#
#   cli       inherit the machine's own `claude` login. The default, and what
#             makes this work on a laptop with nothing set. Install Claude Code
#             and run `claude` once.
#   api_key   use ANTHROPIC_API_KEY below. What a deployment uses.
#   oauth     use CLAUDE_CODE_OAUTH_TOKEN below.
#
# In `cli` mode ANTHROPIC_API_KEY is REMOVED from the process rather than merely
# ignored, because an injected key outranks the machine's login instead of
# supplementing it.
HEATCANYON_AGENT_AUTH=cli
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_CODE_OAUTH_TOKEN=...

# Switch the analyst off entirely. Everything else in the application still works.
# HEATCANYON_AGENT=0

# The model is PINNED rather than left unset, because an unset model means the
# CLI's own default and that is not a decision this project should delegate.
# HEATCANYON_AGENT_MODEL=claude-sonnet-5
# HEATCANYON_AGENT_EFFORT=high

# Three bounds on spend, and they do different jobs.
#   BUDGET_USD          one turn. Real and harness-enforced, but invisible to the
#                       model, so it cuts mid-tool-call. The runaway guard.
#   TASK_BUDGET_TOKENS  a countdown the model can SEE, so it wraps up and answers
#                       rather than being guillotined holding the finding.
#   SESSION_BUDGET_USD  this whole server process, across every run. A demo left
#                       open in a tab should not be able to spend without limit.
# HEATCANYON_AGENT_BUDGET_USD=2.50
# HEATCANYON_AGENT_SESSION_BUDGET_USD=40
# HEATCANYON_AGENT_TASK_BUDGET_TOKENS=400000
# HEATCANYON_AGENT_TIMEOUT_S=900
# HEATCANYON_AGENT_MAX_CONCURRENT=3
# HEATCANYON_AGENT_SUBAGENTS=1
# HEATCANYON_AGENT_THINKING=summarized
# HEATCANYON_AGENT_WORKSPACE=.agent
